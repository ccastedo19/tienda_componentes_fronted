# Desarrollo: usa el proxy de Vite (evita CORS)
VITE_API_BASE_URL=/api/v1

# Producción (ejemplo directo al backend):
# VITE_API_BASE_URL=http://192.168.0.20:8080/api/v1

# Login con correo y contraseña
VITE_AUTH_LOGIN_PATH=/auth/login

# Perfil del usuario autenticado (requiere Bearer token):
# GET /auth/me
